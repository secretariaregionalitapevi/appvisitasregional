DJANGO_SECRET_KEY=replace-with-a-strong-secret
DJANGO_DEBUG=False
DJANGO_ENV=production
DJANGO_ALLOWED_HOSTS=appvisitasregional.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://appvisitasregional.vercel.app
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
SUPABASE_ANON_KEY=replace-with-your-anon-key
GOOGLE_MAPS_API_KEY=replace-with-your-google-maps-key
SAM_GOOGLE_SHEET_ID=replace-with-the-sam-sheet-id
SAM_GOOGLE_CREDENTIALS_FILE=/secure/path/to/service-account.json
SAM_SCRAPER_DIR=C:\path\to\PROJETO_SAM_EVOLUCAO
# Consulta novos alunos em até 2 minutos quando a fila de históricos está vazia.
SAM_SYNC_INTERVAL_SECONDS=120
SAM_SYNC_HISTORY_LIMIT=100
