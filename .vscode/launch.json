{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: executar e abrir no navegador",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": [
        "runserver",
        "127.0.0.1:8000"
      ],
      "django": true,
      "justMyCode": true,
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Starting development server at (https?://\\S+)",
        "uriFormat": "%s"
      }
    }
  ]
}
