{
  "version": 2,
  "builds": [
    {
      "src": "ColorAdmin/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.12",
        "excludeFiles": "{static/**,ColorAdminApp/gulp/**}"
      }
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "ColorAdmin/wsgi.py"
    }
  ]
}
